<Application x:Class="NoteSpace.App.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>
      <Color x:Key="SystemAccentColor">#803AB3</Color>
      <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#803AB3" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#EFE3F7" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#E8D8F3" />
      <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#DBC5EA" />
      <SolidColorBrush x:Key="ListViewItemForegroundSelected" Color="#492264" />
      <SolidColorBrush x:Key="ListViewItemForegroundSelectedPointerOver" Color="#492264" />
      <SolidColorBrush x:Key="ListViewItemForegroundSelectedPressed" Color="#492264" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
