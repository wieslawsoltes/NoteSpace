<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>Skia;SkiaRenderer</UnoFeatures>
    <ApplicationTitle>NoteSpace</ApplicationTitle>
    <ApplicationId>org.notespace.app</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>NoteSpace</ApplicationPublisher>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmShellILLinkerEnabled>false</WasmShellILLinkerEnabled>
    <WasmShellWebAppBasePath>/NoteSpace/</WasmShellWebAppBasePath>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('browserwasm'))">
    <DefineConstants>$(DefineConstants);BROWSER_WASM</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('browserwasm'))">
    <EmbeddedResource Include="Platforms/WebAssembly/WasmScripts/NoteSpaceHost.js" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NoteSpace.Controls/NoteSpace.Controls.csproj" />
    <ProjectReference Include="../NoteSpace.Storage/NoteSpace.Storage.csproj" />
    <PackageReference Include="Uno.Fonts.OpenSans" Version="0.2.0" />
  </ItemGroup>
</Project>
